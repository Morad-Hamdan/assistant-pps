# Configuration de production — conteneur de demonstration.
#
# Ce fichier est un MODELE SANS AUCUN SECRET : ni APP_KEY, ni mot de passe,
# ni URL publique. Le conteneur le copie en laravel/.env au premier
# demarrage, puis `php artisan key:generate` y insere une cle fraiche.
#
# Les variables definies dans l'environnement du conteneur (APP_URL,
# FASTAPI_URL, APP_DEBUG...) prennent PRIORITY sur ce fichier — Laravel ne
# reecrit pas les variables d'environnement existantes.

APP_NAME=Assistant
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# SQLite uniquement — aucune base de donnees externe a configurer.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Point d'entree de l'API FastAPI. Ecrase par la variable FASTAPI_URL
# positionnee par docker-entrypoint.sh (elle doit suivre API_PORT).
FASTAPI_URL=http://127.0.0.1:8010
